# Copy to .env and fill in the model section — the examples/ scripts load it
# with python-dotenv.
#
# Note: since 0.9.37 `lovia web` does NOT read this file or the model env
# vars below — its model connection, vision/aux roles and web-search key live
# in .lovia/config.json, managed in the web UI (Settings → Models).

# --- model ---
# "<vendor>:<model>"; a bare name means "some OpenAI-compatible endpoint".
LOVIA_MODEL=openai:gpt-5.5
OPENAI_API_KEY=sk-...

# Any OpenAI-compatible service (DeepSeek, Ollama, vLLM, ...): point the base
# URL at it and keep using LOVIA_MODEL for its model id.
# OPENAI_BASE_URL=https://api.deepseek.com

# Anthropic instead: LOVIA_MODEL=anthropic:claude-4-8-opus
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=

# --- web search (examples/ only) ---
# Set for the Tavily backend; unset falls back to keyless DuckDuckGo (lovia[ddg]).
# For `lovia web`, put the key in .lovia/config.json ("search" section) instead.
# TAVILY_API_KEY=tvly-...

# --- images (lovia web) ---
# Vision now lives in .lovia/config.json: set a profile's "vision" to "on"
# when your main model is multimodal on a custom endpoint, or assign a
# separate vision-model profile to the "vision" role for the see_image tool.

# --- uploads (lovia web) ---
# LOVIA_MAX_UPLOAD_MB=25              # per-file limit, MiB
# LOVIA_UPLOAD_ALLOWED_EXT=*          # default: common image/doc/data/code types
